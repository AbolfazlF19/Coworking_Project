@model IEnumerable<CoworkingSpace.Web.Models.SpaceEquipment>
@{
    ViewData["Title"] = "Space-Equipment Assignments";
}

<style>
    .assignments-wrapper {
        min-height: 80vh;
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        padding: 1.5rem;
        border-radius: 0;
    }

    .assignments-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .assignments-header h3 {
            font-weight: 800;
            font-size: 1.8rem;
            letter-spacing: -0.025em;
            color: #0f172a;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

            .assignments-header h3 i {
                color: #4f46e5;
            }

    .btn-new-assignment {
        background: linear-gradient(135deg, #4f46e5, #4338ca);
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 60px;
        font-weight: 700;
        font-size: 0.9rem;
        color: #fff;
        transition: all 0.25s ease;
        box-shadow: 0 8px 20px -6px rgba(79, 70, 229, 0.3);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

        .btn-new-assignment:hover {
            background: linear-gradient(135deg, #4338ca, #3730a3);
            transform: translateY(-2px);
            box-shadow: 0 12px 28px -8px rgba(79, 70, 229, 0.4);
            color: #fff;
            text-decoration: none;
        }

        .btn-new-assignment i {
            font-size: 1.1rem;
        }

    .assignments-table-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 2rem;
        box-shadow: 0 12px 32px -12px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .assignments-table-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px -14px rgba(0, 0, 0, 0.12);
        }

        .assignments-table-card .table {
            margin-bottom: 0;
            font-size: 0.9rem;
        }

            .assignments-table-card .table thead th {
                background: #f8fafc;
                color: #475569;
                font-weight: 700;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.03em;
                padding: 0.9rem 1rem;
                border-bottom: 1px solid #e2e8f0;
            }

            .assignments-table-card .table tbody td {
                padding: 0.8rem 1rem;
                vertical-align: middle;
                border-bottom: 1px solid #f1f5f9;
                color: #1e293b;
            }

            .assignments-table-card .table tbody tr:hover {
                background: rgba(241, 245, 249, 0.6);
                transition: background 0.15s;
            }

            .assignments-table-card .table tbody tr:last-child td {
                border-bottom: none;
            }

    .space-name {
        font-weight: 700;
        color: #0f172a;
    }

    .equipment-name {
        color: #4f46e5;
        font-weight: 600;
    }

    .quantity-badge {
        background: rgba(79, 70, 229, 0.08);
        padding: 0.2rem 0.8rem;
        border-radius: 60px;
        font-weight: 600;
        font-size: 0.85rem;
        color: #4f46e5;
        display: inline-block;
    }

    .notes-cell {
        color: #64748b;
        font-size: 0.85rem;
        max-width: 180px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }

    .action-btns {
        display: flex;
        gap: 0.4rem;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    .btn-action {
        padding: 0.3rem 0.9rem;
        border-radius: 60px;
        font-size: 0.75rem;
        font-weight: 600;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        border: 1.5px solid transparent;
    }

        .btn-action i {
            font-size: 0.85rem;
        }

    .btn-action-edit {
        background: rgba(79, 70, 229, 0.1);
        border-color: #818cf8;
        color: #4f46e5;
    }

        .btn-action-edit:hover {
            background: rgba(79, 70, 229, 0.2);
            border-color: #4f46e5;
            color: #3730a3;
            text-decoration: none;
        }

    .btn-action-remove {
        background: rgba(220, 38, 38, 0.08);
        border-color: #fca5a5;
        color: #dc2626;
    }

        .btn-action-remove:hover {
            background: rgba(220, 38, 38, 0.15);
            border-color: #ef4444;
            color: #b91c1c;
            text-decoration: none;
        }

    .empty-state {
        padding: 3rem 1.5rem;
        text-align: center;
        color: #94a3b8;
    }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 0.75rem;
            display: block;
            opacity: 0.4;
        }

        .empty-state .empty-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #475569;
            margin-bottom: 0.25rem;
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .assignments-wrapper {
            padding: 0.75rem;
        }

        .assignments-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .action-btns {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 576px) {
        .assignments-table-card .table {
            font-size: 0.8rem;
        }

            .assignments-table-card .table thead th,
            .assignments-table-card .table tbody td {
                padding: 0.5rem 0.6rem;
            }

        .btn-action {
            padding: 0.2rem 0.6rem;
            font-size: 0.65rem;
        }

        .action-btns {
            gap: 0.2rem;
        }

        .notes-cell {
            max-width: 80px;
        }

        .quantity-badge {
            font-size: 0.75rem;
            padding: 0.1rem 0.6rem;
        }
    }
</style>

<div class="assignments-wrapper">
    <!-- Header -->
    <div class="assignments-header">
        <h3>
            <i class="bi bi-diagram-3"></i>
            Space-Equipment Assignments
        </h3>
        <a asp-action="Create" class="btn-new-assignment">
            <i class="bi bi-plus-lg"></i> Assign Equipment
        </a>
    </div>

    <!-- Table Card -->
    <div class="assignments-table-card">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <div class="empty-title">No assignments found</div>
                    <span class="text-muted">Start by assigning equipment to a space.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Space</th>
                                <th>Equipment</th>
                                <th>Quantity</th>
                                <th>Notes</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="space-name">@item.Space?.SpaceName</td>
                                    <td class="equipment-name">@item.Equipment?.Name</td>
                                    <td><span class="quantity-badge">@item.Quantity</span></td>
                                    <td>
                                        @if (string.IsNullOrEmpty(item.Notes))
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            <span class="notes-cell" title="@item.Notes">@item.Notes</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="action-btns">
                                            <a asp-action="Edit"
                                               asp-route-spaceId="@item.SpaceId"
                                               asp-route-equipmentId="@item.EquipmentId"
                                               class="btn-action btn-action-edit" title="Edit">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <a asp-action="Delete"
                                               asp-route-spaceId="@item.SpaceId"
                                               asp-route-equipmentId="@item.EquipmentId"
                                               class="btn-action btn-action-remove" title="Remove">
                                                <i class="bi bi-trash"></i> Remove
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
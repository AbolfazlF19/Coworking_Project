@model IEnumerable<CoworkingSpace.Web.Models.Space>
@using Microsoft.AspNetCore.Identity
@using CoworkingSpace.Web.Models
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Welcome";
}

<style>
    .home-wrapper {
        min-height: 80vh;
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        padding: 1.5rem;
        border-radius: 0;
    }

    /* Hero Section */
    .hero-section {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 50%, #1e293b 100%);
        border-radius: 2.5rem;
        padding: 3.5rem 3rem;
        margin-bottom: 2.5rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 40px -12px rgba(15, 23, 42, 0.3);
    }
    .hero-section::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.15) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    .hero-section::after {
        content: '';
        position: absolute;
        bottom: -30%;
        left: -10%;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.1) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 680px;
    }
    .hero-content h1 {
        font-size: 2.8rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        color: #ffffff;
        margin-bottom: 0.75rem;
        line-height: 1.2;
    }
    .hero-content h1 span {
        background: linear-gradient(135deg, #60a5fa, #a78bfa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .hero-content .lead {
        font-size: 1.15rem;
        color: #cbd5e1;
        margin-bottom: 1.8rem;
        line-height: 1.6;
        max-width: 520px;
    }
    .hero-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }
    .btn-hero-primary {
        background: #ffffff;
        border: none;
        padding: 0.7rem 2.2rem;
        border-radius: 60px;
        font-weight: 700;
        font-size: 1rem;
        color: #0f172a;
        transition: all 0.25s ease;
        box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.25);
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
    }
    .btn-hero-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 30px -8px rgba(0, 0, 0, 0.35);
        color: #0f172a;
        text-decoration: none;
        background: #f8fafc;
    }
    .btn-hero-secondary {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1.5px solid rgba(255, 255, 255, 0.25);
        padding: 0.7rem 2.2rem;
        border-radius: 60px;
        font-weight: 700;
        font-size: 1rem;
        color: #ffffff;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
    }
    .btn-hero-secondary:hover {
        background: rgba(255, 255, 255, 0.2);
        border-color: rgba(255, 255, 255, 0.4);
        transform: translateY(-3px);
        color: #ffffff;
        text-decoration: none;
    }
    .btn-hero-book {
        background: linear-gradient(135deg, #4f46e5, #4338ca);
        border: none;
        padding: 0.7rem 2.2rem;
        border-radius: 60px;
        font-weight: 700;
        font-size: 1rem;
        color: #ffffff;
        transition: all 0.25s ease;
        box-shadow: 0 8px 20px -6px rgba(79, 70, 229, 0.4);
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
    }
    .btn-hero-book:hover {
        background: linear-gradient(135deg, #4338ca, #3730a3);
        transform: translateY(-3px);
        box-shadow: 0 14px 30px -8px rgba(79, 70, 229, 0.5);
        color: #ffffff;
        text-decoration: none;
    }

    /* Spaces Section */
    .spaces-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }
    .spaces-header h3 {
        font-weight: 800;
        font-size: 1.8rem;
        letter-spacing: -0.025em;
        color: #0f172a;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }
    .spaces-header h3 i {
        color: #4f46e5;
    }

    /* Space Card with Image Slider */
    .space-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 1.8rem;
        box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.06);
        transition: all 0.3s ease;
        height: 100%;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .space-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px -14px rgba(0, 0, 0, 0.15);
        background: rgba(255, 255, 255, 0.92);
    }
    .space-card .card-body {
        padding: 1.5rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    /* Image Slider */
    .space-slider {
        position: relative;
        width: 100%;
        height: 200px;
        overflow: hidden;
        border-radius: 1rem;
        margin-bottom: 0.75rem;
        background: #e2e8f0;
        cursor: pointer;
    }
    .space-slider .slider-track {
        display: flex;
        transition: transform 0.4s ease;
        height: 100%;
    }
    .space-slider .slider-track img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        flex-shrink: 0;
        flex: 0 0 100%;
        background: #f1f5f9;
    }
    .space-slider .slider-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0, 0, 0, 0.4);
        color: #fff;
        border: none;
        border-radius: 50%;
        width: 32px;
        height: 32px;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s;
        z-index: 5;
        backdrop-filter: blur(4px);
    }
    .space-slider .slider-btn:hover {
        background: rgba(0, 0, 0, 0.7);
    }
    .space-slider .slider-btn.prev {
        left: 8px;
    }
    .space-slider .slider-btn.next {
        right: 8px;
    }
    .space-slider .slider-dots {
        position: absolute;
        bottom: 8px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 6px;
        z-index: 5;
    }
    .space-slider .slider-dots span {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.5);
        transition: background 0.2s;
        cursor: pointer;
    }
    .space-slider .slider-dots span.active {
        background: #ffffff;
    }
    .space-slider .no-image {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #94a3b8;
        font-size: 0.9rem;
        background: #f1f5f9;
    }
    .space-slider .no-image i {
        font-size: 2.5rem;
        margin-right: 0.5rem;
        opacity: 0.4;
    }

    .space-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.5rem;
        gap: 0.5rem;
    }
    .space-card-header .space-name {
        font-weight: 700;
        font-size: 1.15rem;
        color: #0f172a;
        margin: 0;
        line-height: 1.3;
    }
    .space-type-badge {
        background: rgba(79, 70, 229, 0.1);
        color: #4f46e5;
        padding: 0.2rem 0.8rem;
        border-radius: 60px;
        font-size: 0.7rem;
        font-weight: 600;
        white-space: nowrap;
        text-transform: capitalize;
        border: 1px solid rgba(79, 70, 229, 0.15);
    }
    .space-details {
        flex: 1;
        margin-top: 0.25rem;
    }
    .space-details .detail-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #475569;
        font-size: 0.9rem;
        margin-bottom: 0.25rem;
    }
    .space-details .detail-item i {
        color: #64748b;
        font-size: 1rem;
        width: 1.2rem;
        text-align: center;
    }
    .space-details .detail-item strong {
        color: #0f172a;
        font-weight: 600;
    }

    .space-card .card-footer-actions {
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px solid #f1f5f9;
        display: flex;
        gap: 0.5rem;
    }

    .btn-book-space {
        background: linear-gradient(135deg, #4f46e5, #4338ca);
        border: none;
        padding: 0.5rem 1.2rem;
        border-radius: 60px;
        font-weight: 600;
        font-size: 0.85rem;
        color: #ffffff;
        transition: all 0.25s ease;
        box-shadow: 0 6px 16px -6px rgba(79, 70, 229, 0.3);
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        text-decoration: none;
    }
    .btn-book-space:hover {
        background: linear-gradient(135deg, #4338ca, #3730a3);
        transform: translateY(-2px);
        box-shadow: 0 10px 24px -8px rgba(79, 70, 229, 0.4);
        color: #ffffff;
        text-decoration: none;
    }
    .btn-login-to-book {
        background: rgba(255, 255, 255, 0.6);
        border: 1.5px solid #e2e8f0;
        padding: 0.5rem 1.2rem;
        border-radius: 60px;
        font-weight: 600;
        font-size: 0.85rem;
        color: #475569;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        text-decoration: none;
    }
    .btn-login-to-book:hover {
        background: #ffffff;
        border-color: #94a3b8;
        color: #0f172a;
        text-decoration: none;
        transform: translateY(-2px);
    }

    .empty-state {
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 1.5rem;
        padding: 3rem 1.5rem;
        text-align: center;
        color: #64748b;
    }
    .empty-state i {
        font-size: 3rem;
        margin-bottom: 0.75rem;
        display: block;
        opacity: 0.4;
        color: #94a3b8;
    }
    .empty-state .empty-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: 0.25rem;
    }

    /* ===== LIGHTBOX (Full-screen image viewer) ===== */
    .lightbox-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.92);
        backdrop-filter: blur(8px);
        z-index: 9999;
        justify-content: center;
        align-items: center;
        padding: 2rem;
        cursor: pointer;
    }
    .lightbox-overlay.active {
        display: flex;
    }
    .lightbox-overlay .lightbox-content {
        max-width: 90%;
        max-height: 85vh;
        border-radius: 1rem;
        object-fit: contain;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
        cursor: default;
    }
    .lightbox-overlay .lightbox-close {
        position: fixed;
        top: 1.5rem;
        right: 2rem;
        font-size: 2.5rem;
        color: #fff;
        background: none;
        border: none;
        cursor: pointer;
        opacity: 0.7;
        transition: opacity 0.2s;
        z-index: 10000;
    }
    .lightbox-overlay .lightbox-close:hover {
        opacity: 1;
    }
    .lightbox-overlay .lightbox-nav {
        position: fixed;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
        border: none;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        font-size: 1.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s;
        backdrop-filter: blur(6px);
        z-index: 10000;
    }
    .lightbox-overlay .lightbox-nav:hover {
        background: rgba(255, 255, 255, 0.3);
    }
    .lightbox-overlay .lightbox-nav.prev {
        left: 1.5rem;
    }
    .lightbox-overlay .lightbox-nav.next {
        right: 1.5rem;
    }
    .lightbox-overlay .lightbox-counter {
        position: fixed;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.9rem;
        background: rgba(0, 0, 0, 0.4);
        padding: 0.4rem 1.2rem;
        border-radius: 60px;
        backdrop-filter: blur(4px);
        z-index: 10000;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .home-wrapper { padding: 0.75rem; }
        .hero-section { padding: 2rem 1.5rem; border-radius: 1.8rem; }
        .hero-content h1 { font-size: 2rem; }
        .hero-content .lead { font-size: 1rem; }
        .hero-buttons { flex-direction: column; align-items: stretch; }
        .hero-buttons a { justify-content: center; }
        .spaces-header h3 { font-size: 1.4rem; }
        .space-slider { height: 160px; }
        .lightbox-overlay .lightbox-nav { width: 40px; height: 40px; font-size: 1.4rem; }
        .lightbox-overlay .lightbox-nav.prev { left: 0.5rem; }
        .lightbox-overlay .lightbox-nav.next { right: 0.5rem; }
    }

    @@media (max-width: 576px) {
        .hero-section { padding: 1.5rem 1rem; }
        .hero-content h1 { font-size: 1.6rem; }
        .space-card .card-body { padding: 1.2rem; }
        .space-card-header { flex-direction: column; align-items: flex-start; gap: 0.3rem; }
        .space-card .card-footer-actions { flex-direction: column; align-items: stretch; }
        .btn-book-space, .btn-login-to-book { justify-content: center; }
        .space-slider { height: 140px; }
    }
</style>

<div class="home-wrapper">
    <!-- Hero Section -->
    <div class="hero-section">
        <div class="hero-content">
            <h1>
                Find &amp; book your<br>
                <span>perfect workspace</span>
            </h1>
            <p class="lead">
                Meeting rooms, conference halls and private offices — managed end to end. Reserve online in seconds.
            </p>
            <div class="hero-buttons">
                @if (!SignInManager.IsSignedIn(User))
                {
                    <a class="btn-hero-primary" asp-controller="Account" asp-action="Register">
                        <i class="bi bi-person-plus"></i> Get started
                    </a>
                    <a class="btn-hero-secondary" asp-controller="Account" asp-action="Login">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                }
                else
                {
                    <a class="btn-hero-book" asp-controller="Reservations" asp-action="Create">
                        <i class="bi bi-calendar-plus"></i> Book a space
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Spaces Section -->
    <div class="spaces-header">
        <h3>
            <i class="bi bi-building"></i>
            Available Spaces
        </h3>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <div class="empty-title">No spaces available</div>
            <span class="text-muted">Please check back later for new listings.</span>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var space in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="space-card">
                        <div class="card-body">
                            <!-- Image Slider -->
                            <div class="space-slider" data-spaceid="@space.SpaceId">
                                <div class="slider-track">
                                    @if (space.Images != null && space.Images.Any())
                                    {
                                        foreach (var img in space.Images.OrderBy(i => i.DisplayOrder))
                                        {
                                            <img src="@img.ImagePath" alt="@space.SpaceName" loading="lazy" />
                                        }
                                    }
                                    else
                                    {
                                        <div class="no-image">
                                            <i class="bi bi-image"></i> No images
                                        </div>
                                    }
                                </div>
                                @if (space.Images != null && space.Images.Count() > 1)
                                {
                                    <button class="slider-btn prev" type="button"><i class="bi bi-chevron-left"></i></button>
                                    <button class="slider-btn next" type="button"><i class="bi bi-chevron-right"></i></button>
                                    <div class="slider-dots">
                                        @for (int i = 0; i < space.Images.Count(); i++)
                                        {
                                            <span class="@(i == 0 ? "active" : "")" data-index="@i"></span>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="space-card-header">
                                <h5 class="space-name">@space.SpaceName</h5>
                                <span class="space-type-badge">@space.SpaceType.ToSpacedString()</span>
                            </div>
                            <div class="space-details">
                                <div class="detail-item">
                                    <i class="bi bi-geo-alt"></i>
                                    <span>@space.Location</span>
                                </div>
                                <div class="detail-item">
                                    <i class="bi bi-people"></i>
                                    <span>Capacity: <strong>@space.Capacity</strong></span>
                                </div>
                            </div>
                            <div class="card-footer-actions">
                                @if (SignInManager.IsSignedIn(User) && User.IsInRole("Member"))
                                {
                                    <a class="btn-book-space" asp-controller="Reservations" asp-action="Create" asp-route-spaceId="@space.SpaceId">
                                        <i class="bi bi-calendar-plus"></i> Book now
                                    </a>
                                    <a class="btn-outline-primary" asp-controller="MemberSpaces" asp-action="Details" asp-route-id="@space.SpaceId">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                }
                                else if (!SignInManager.IsSignedIn(User))
                                {
                                    <a class="btn-login-to-book" asp-controller="Account" asp-action="Login">
                                        <i class="bi bi-box-arrow-in-right"></i> Login to book
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ===== LIGHTBOX ===== -->
<div class="lightbox-overlay" id="lightbox">
    <button class="lightbox-close" id="lightboxClose"><i class="bi bi-x-lg"></i></button>
    <button class="lightbox-nav prev" id="lightboxPrev"><i class="bi bi-chevron-left"></i></button>
    <button class="lightbox-nav next" id="lightboxNext"><i class="bi bi-chevron-right"></i></button>
    <img class="lightbox-content" id="lightboxImg" src="" alt="Full view" />
    <div class="lightbox-counter" id="lightboxCounter">1 / 1</div>
</div>

@section Scripts {
    <script>
        (function () {
            // ============================================================
            // 1. INITIALIZE SLIDERS
            // ============================================================
            document.querySelectorAll('.space-slider').forEach(function (slider) {
                var track = slider.querySelector('.slider-track');
                var images = track ? track.querySelectorAll('img') : [];
                var total = images.length;

                // اگر تصویری وجود نداشت، اسلایدر را غیرفعال کن
                if (total === 0) return;

                var currentIndex = 0;
                var prevBtn = slider.querySelector('.slider-btn.prev');
                var nextBtn = slider.querySelector('.slider-btn.next');
                var dots = slider.querySelectorAll('.slider-dots span');

                function goTo(index) {
                    if (index < 0) index = total - 1;
                    if (index >= total) index = 0;
                    currentIndex = index;
                    track.style.transform = 'translateX(-' + (index * 100) + '%)';
                    // به‌روزرسانی dots
                    dots.forEach(function (dot, i) {
                        dot.classList.toggle('active', i === index);
                    });
                }

                function next() { goTo(currentIndex + 1); }
                function prev() { goTo(currentIndex - 1); }

                if (prevBtn) prevBtn.addEventListener('click', function (e) { e.stopPropagation(); prev(); });
                if (nextBtn) nextBtn.addEventListener('click', function (e) { e.stopPropagation(); next(); });

                dots.forEach(function (dot, i) {
                    dot.addEventListener('click', function (e) {
                        e.stopPropagation();
                        goTo(i);
                    });
                });

                // پشتیبانی از کیبورد (اختیاری)
                slider.addEventListener('keydown', function (e) {
                    if (e.key === 'ArrowLeft') prev();
                    if (e.key === 'ArrowRight') next();
                });

                // ذخیره‌ی توابع در خود المان برای استفاده در لایت‌باکس
                slider._images = images;
                slider._goTo = goTo;
                slider._currentIndex = function () { return currentIndex; };
            });

            // ============================================================
            // 2. LIGHTBOX (full-screen image viewer)
            // ============================================================
            var lightbox = document.getElementById('lightbox');
            var lightboxImg = document.getElementById('lightboxImg');
            var lightboxCounter = document.getElementById('lightboxCounter');
            var closeBtn = document.getElementById('lightboxClose');
            var prevBtnLightbox = document.getElementById('lightboxPrev');
            var nextBtnLightbox = document.getElementById('lightboxNext');

            var activeSlider = null;
            var activeImages = [];
            var activeIndex = 0;

            function openLightbox(slider, index) {
                activeSlider = slider;
                activeImages = slider._images || [];
                activeIndex = index || 0;

                if (activeImages.length === 0) return;

                showImage(activeIndex);
                lightbox.classList.add('active');
                document.body.style.overflow = 'hidden';
            }

            function showImage(index) {
                if (activeImages.length === 0) return;
                if (index < 0) index = activeImages.length - 1;
                if (index >= activeImages.length) index = 0;
                activeIndex = index;
                var src = activeImages[index] ? activeImages[index].getAttribute('src') : '';
                lightboxImg.setAttribute('src', src);
                lightboxCounter.textContent = (index + 1) + ' / ' + activeImages.length;
            }

            function closeLightbox() {
                lightbox.classList.remove('active');
                document.body.style.overflow = '';
                activeSlider = null;
                activeImages = [];
            }

            // کلیک روی تصویر اسلایدر → باز کردن لایت‌باکس
            document.querySelectorAll('.space-slider .slider-track img').forEach(function (img) {
                img.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var slider = this.closest('.space-slider');
                    if (!slider) return;
                    // پیدا کردن اندیس این تصویر در اسلایدر
                    var images = slider.querySelectorAll('.slider-track img');
                    var index = 0;
                    images.forEach(function (im, i) {
                        if (im === img) index = i;
                    });
                    // اگر اسلایدر قبلاً مقدار _images را ذخیره نکرده، اینجا تنظیم کن
                    if (!slider._images || slider._images.length === 0) {
                        slider._images = images;
                    }
                    openLightbox(slider, index);
                });
            });

            // دکمه‌های لایت‌باکس
            if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
            if (prevBtnLightbox) prevBtnLightbox.addEventListener('click', function () { showImage(activeIndex - 1); });
            if (nextBtnLightbox) nextBtnLightbox.addEventListener('click', function () { showImage(activeIndex + 1); });

            // کلیک روی پس‌زمینه لایت‌باکس → بسته شود
            lightbox.addEventListener('click', function (e) {
                if (e.target === lightbox) closeLightbox();
            });

            // کیبورد در لایت‌باکس
            document.addEventListener('keydown', function (e) {
                if (!lightbox.classList.contains('active')) return;
                if (e.key === 'Escape') closeLightbox();
                if (e.key === 'ArrowLeft') showImage(activeIndex - 1);
                if (e.key === 'ArrowRight') showImage(activeIndex + 1);
            });
        })();
    </script>
}
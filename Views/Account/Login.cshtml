@model CoworkingSpace.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<style>
    .login-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        padding: 1.5rem;
    }

    .login-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 2.5rem;
        padding: 2.5rem 2rem;
        max-width: 460px;
        width: 100%;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.6);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .login-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.25);
        }

    .login-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(145deg, #dbeafe, #bfdbfe);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.2rem;
        box-shadow: 0 12px 28px -10px rgba(37, 99, 235, 0.25);
    }

        .login-icon i {
            font-size: 2.8rem;
            color: #2563eb;
            text-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
        }

    .login-title {
        font-size: 1.8rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        color: #0f172a;
        text-align: center;
        margin-bottom: 0.25rem;
    }

    .login-sub {
        text-align: center;
        color: #64748b;
        font-size: 0.95rem;
        margin-bottom: 1.8rem;
    }

    .form-floating-custom {
        margin-bottom: 1.25rem;
    }

        .form-floating-custom label {
            font-weight: 600;
            font-size: 0.85rem;
            color: #334155;
            margin-bottom: 0.35rem;
            display: block;
        }

        .form-floating-custom .form-control {
            background: rgba(255, 255, 255, 0.7);
            border: 1.5px solid #e2e8f0;
            border-radius: 1rem;
            padding: 0.7rem 1rem;
            font-size: 0.95rem;
            transition: all 0.25s ease;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
        }

            .form-floating-custom .form-control:focus {
                border-color: #3b82f6;
                box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15), inset 0 2px 4px rgba(0,0,0,0.02);
                background: #ffffff;
            }

        .form-floating-custom .text-danger {
            font-size: 0.8rem;
            margin-top: 0.3rem;
            display: block;
        }

    .custom-check {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

        .custom-check input[type="checkbox"] {
            width: 1.1rem;
            height: 1.1rem;
            accent-color: #2563eb;
            border-radius: 0.3rem;
            cursor: pointer;
        }

        .custom-check label {
            font-size: 0.9rem;
            color: #334155;
            cursor: pointer;
            user-select: none;
        }

    .btn-login {
        background: linear-gradient(135deg, #1e293b, #0f172a);
        border: none;
        padding: 0.75rem;
        border-radius: 60px;
        font-weight: 700;
        font-size: 1rem;
        color: #fff;
        transition: all 0.25s ease;
        box-shadow: 0 8px 20px -6px rgba(15, 23, 42, 0.3);
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
    }

        .btn-login:hover {
            background: linear-gradient(135deg, #0f172a, #020617);
            transform: translateY(-2px);
            box-shadow: 0 12px 28px -8px rgba(15, 23, 42, 0.4);
            color: #fff;
        }

        .btn-login i {
            font-size: 1.2rem;
            transition: transform 0.2s;
        }

        .btn-login:hover i {
            transform: translateX(4px);
        }

    .demo-box {
        background: #f8fafc;
        border-radius: 1rem;
        padding: 0.8rem 1rem;
        margin-top: 1.5rem;
        border: 1px dashed #cbd5e1;
    }

        .demo-box strong {
            color: #0f172a;
            font-size: 0.85rem;
            display: block;
            margin-bottom: 0.3rem;
        }

        .demo-box code {
            background: #e2e8f0;
            padding: 0.15rem 0.6rem;
            border-radius: 20px;
            font-size: 0.75rem;
            color: #1e293b;
            word-break: break-all;
        }

        .demo-box .row-code {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem 1.2rem;
            margin-top: 0.2rem;
        }

            .demo-box .row-code span {
                font-size: 0.8rem;
                color: #475569;
            }

    .register-link {
        text-align: center;
        margin-top: 1.2rem;
        font-size: 0.9rem;
        color: #64748b;
    }

        .register-link a {
            color: #2563eb;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.2s;
        }

            .register-link a:hover {
                color: #1e40af;
                text-decoration: underline;
            }

    /* validation summary override */
    .validation-summary-errors ul {
        padding-left: 0;
        list-style: none;
        margin-bottom: 0.75rem;
    }

    .validation-summary-errors li {
        background: #fee2e2;
        color: #b91c1c;
        border-radius: 0.75rem;
        padding: 0.4rem 0.9rem;
        font-size: 0.85rem;
        margin-bottom: 0.3rem;
        border-left: 4px solid #dc2626;
    }

    /* Responsive */
    @@media (max-width: 576px) {
        .login-card {
            padding: 1.8rem 1.2rem;
        }

        .login-icon {
            width: 65px;
            height: 65px;
        }

            .login-icon i {
                font-size: 2.2rem;
            }

        .login-title {
            font-size: 1.5rem;
        }

        .demo-box .row-code {
            flex-direction: column;
            gap: 0.3rem;
        }
    }
</style>

<div class="login-wrapper">
    <div class="login-card">
        <!-- Icon -->
        <div class="login-icon">
            <i class="bi bi-person-circle"></i>
        </div>

        <h1 class="login-title">Welcome back</h1>
        <p class="login-sub">Sign in to your CoSpace account.</p>

        <!-- Form -->
        <form asp-action="Login" asp-controller="Account" method="post">
            <div asp-validation-summary="All" class="validation-summary-errors text-danger"></div>
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="form-floating-custom">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" placeholder="your@email.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-floating-custom">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="custom-check">
                <input asp-for="RememberMe" />
                <label asp-for="RememberMe"></label>
            </div>

            <button type="submit" class="btn-login">
                <i class="bi bi-box-arrow-in-right"></i> Login
            </button>
        </form>

        <!--
        Demo accounts 
        <div class="demo-box">
            <strong>Demo accounts</strong>
            <div class="row-code">
                <span><strong>Admin:</strong> <code>admin@coworking.com</code> / <code>Admin@123</code></span>
                <span><strong>Member:</strong> <code>member@coworking.com</code> / <code>Member@123</code></span>
            </div>
        </div>
        -->

        <div class="register-link">
            New here? <a asp-controller="Account" asp-action="Register">Create a member account</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}